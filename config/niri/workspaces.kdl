// =============================================================================
// Named workspaces — included from config.kdl
// =============================================================================
// Named workspaces (as opposed to niri's default dynamic numbered ones)
// keep a stable identity across monitor/output changes, and can be targeted
// directly by name — e.g. window-rules.kdl sends Firefox to "c" on open.
// Order here also sets their relative position among themselves.
// =============================================================================

workspace "c" {
}
workspace "b" {
}
workspace "a" {
}
