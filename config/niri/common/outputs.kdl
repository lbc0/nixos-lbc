// =============================================================================
// Outputs (monitors) — included from config.kdl
// =============================================================================
// Find each output's exact name by running `niri msg outputs` inside a niri
// session. The built-in laptop panel is usually "eDP-1".
// Wiki: https://github.com/niri-wm/niri/wiki/Configuration:-Outputs
//
// Position is in logical (scaled) pixels: a 3840x2160 output at scale 2.0
// has a logical size of 1920x1080, so an adjacent output to its right
// should start at x=1920. If unset, or it overlaps another output, niri
// places it automatically.
// =============================================================================

// ---- Disabled template profiles (the leading "/-" comments out the whole
// ---- node, niri-specific syntax). These look like an alternate/laptop-dock
// ---- profile for these same output names at a different scale (2x,
// ---- presumably HiDPI) — left here disabled as a reference; uncomment the
// ---- "/-" prefix to enable, and disable/remove the active blocks below.
/-output "eDP-1" {
    // off
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=1280 y=0
}

/-output "DP-3" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=0 y=0
}

/-output "DP-5" {
    mode "1920x1080@120.030"
    scale 2
    transform "normal"
    position x=-1280 y=0
}

// ---- Active triple-monitor layout: laptop panel + two external displays,
// ---- all at scale 1, arranged left-to-right in physical/logical order.

// Left Monitor (laptop panel)
output "eDP-1" {
    mode "1920x1080@60.020"
    scale 1
    position x=0 y=0
}

// Center Monitor — focused on startup
output "DP-3" {
    mode "1920x1080@60.000"
    scale 1
    position x=1920 y=0
    focus-at-startup
}

// Right Monitor
output "DP-5" {
    mode "1920x1080@60.000"
    scale 1
    position x=3840 y=0
}
