// =============================================================================
// Startup programs — included from config.kdl
// =============================================================================
// Each spawn-at-startup launches one program (no shell parsing — args are
// passed exactly as written, no pipes/env-vars/globbing). Use
// spawn-sh-at-startup instead if you need shell features.
// =============================================================================

// Disabled alternative bar — quickshell (below) is what's actually in use.
// NOTE: this line's name is misleading leftover from niri's default config
// template, which mentions waybar here; that's not what's running below.
// spawn-at-startup "noctalia-shell"

// Wallpaper, scaled to fill the screen.
spawn-at-startup "swaybg" "-i" "$DOTFILES_LIVE/assets/walls/desktop.png" "-m" "fill"

// Your shell/bar (replaces waybar — see note above).
spawn-at-startup "quickshell"

// Kanshi monitors config
spawn-at-startup "kanshi"

// Idle management (screen lock/dim/suspend on inactivity timers, configured
// elsewhere in your swayidle config).
spawn-at-startup "swayidle"

// Watcher
spawn-at-startup "room-lock-guard"

// For shell commands needing pipes, variables, multiple commands, etc.,
// use spawn-sh-at-startup instead — the whole command is passed to `sh -c`:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"
