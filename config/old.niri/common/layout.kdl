// =============================================================================
// Layout — included from config.kdl
// =============================================================================
// Controls how columns/windows are sized, spaced, and decorated.
// Wiki: https://github.com/niri-wm/niri/wiki/Configuration:-Layout
//
// Note on splitting layout into its own file: niri has a special case where
// an *empty* `border { }` in the main config enables the border, but does
// nothing in an included file — you'd need an explicit `on` to enable it.
// Not an issue here since this file's border block already says `off`
// explicitly, so behavior is unchanged either way.
// =============================================================================

layout {
    // Gap between windows/columns, in logical pixels.
    gaps 5

    // Don't auto-center a column just because it's focused.
    center-focused-column "never"

    // Widths cycled through with Mod+R (switch-preset-column-width).
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // Width new columns open at, as a proportion of screen width.
    default-column-width { proportion 0.5; }

    // Ring drawn around the focused window.
    focus-ring {
        width 1.5
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    // Border drawn around every window (separate from the focus ring).
    // Currently disabled — focus-ring above still shows which window is
    // focused, this just skips the extra always-on border.
    border {
        off

        width 1.5
        active-color "#ffc87f"
        inactive-color "#505050"
        urgent-color "#9b0000"
    }

    // Drop shadow under windows. Currently disabled (the `on` line is
    // commented out) — width/color values below are pre-filled for when
    // you want to turn it on.
    shadow {
        // on

        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // Reserved screen-edge space (e.g. for a bar) that windows won't cover.
    // Empty = no struts reserved.
    struts {
    }
}
