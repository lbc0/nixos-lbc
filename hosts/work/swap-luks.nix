# Unlocks the swap partition's LUKS container during initrd, alongside root.
#
# Why this file exists:
#   hardware.nix (generated by nixos-generate-config) registers root's LUKS
#   mapping in `boot.initrd.luks.devices`, so it gets unlocked early during
#   initrd — that's the passphrase prompt you already see at boot. Swap's
#   LUKS mapping, however, only appears in `swapDevices`, so systemd tries
#   to unlock it later in stage 2 instead. On this machine that later
#   unlock never prompts visibly, so boot just stalls on a start job for
#   up to the default 90s unit timeout ("1min 5s / 1min 30s ...") before
#   continuing.
#
#   Adding the same mapping to `boot.initrd.luks.devices` here makes swap
#   unlock in initrd too, right after root — no more silent 90s stall.
#
# hardware.nix itself is regenerated by `nixos-generate-config` and
# shouldn't be hand-edited (see its own header comment), so this lives in
# its own file instead and gets imported from default.nix.
#
# How the UUID below was found:
#   `lsblk -f` on lbcw showed the swap partition as:
#     nvme0n1p3  crypto  2  c4a9a07a-3be2-467d-b632-ba8670b22c79
#   This is the *encrypted partition's* UUID (crypto_LUKS), not the
#   decrypted mapper name — same value NixOS uses to name the mapper
#   `luks-<uuid>` by convention, which is why the string below matches
#   the `swapDevices` entry in hardware.nix.
{...}: {
  boot.initrd.luks.devices."luks-c4a9a07a-3be2-467d-b632-ba8670b22c79".device = "/dev/disk/by-uuid/c4a9a07a-3be2-467d-b632-ba8670b22c79";

  # Enabling TPM
  boot.initrd.systemd.enable = true; # required for TPM2 unlock in initrd
  security.tpm2.enable = true;
  security.tpm2.pkcs11.enable = true;
  security.tpm2.tctiEnvironment.enable = true;
}
