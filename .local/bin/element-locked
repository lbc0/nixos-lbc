#!/usr/bin/env bash
set -uo pipefail   # no -e: we want cleanup to run regardless of exit codes

CIPHER="$HOME/.local/share/element-encrypted"
MOUNT="$HOME/.config/Element"

mkdir -p "$CIPHER" "$MOUNT"

# Idempotent guard: clear any stale/dead mount from a previous crash
# before trying to mount again.
if mountpoint -q "$MOUNT" 2>/dev/null; then
  echo "Element profile already mounted or stale — clearing it first."
  fusermount -uz "$MOUNT" 2>/dev/null || sudo umount -l "$MOUNT" 2>/dev/null || true
  sleep 0.3
fi

if [ ! -f "$CIPHER/gocryptfs.conf" ]; then
  echo "No encrypted Element profile found yet."
  gocryptfs -init "$CIPHER" < /dev/tty
fi

# setsid launches gocryptfs in its own session, detached from this
# terminal's controlling process group. This means if the terminal is
# closed (SIGHUP), gocryptfs does NOT receive it directly — only this
# script does, giving the trap below a chance to unmount cleanly before
# gocryptfs is torn down. Without setsid, both processes die at once
# on terminal close, which is what caused the stale/dead mount.
setsid gocryptfs -fg "$CIPHER" "$MOUNT" < /dev/tty &
GC_PID=$!

# wait for the mount to actually appear before launching Element
for _ in $(seq 1 50); do
  mountpoint -q "$MOUNT" 2>/dev/null && break
  sleep 0.1
done
if ! mountpoint -q "$MOUNT" 2>/dev/null; then
  echo "gocryptfs failed to mount (wrong passphrase?)."
  kill "$GC_PID" 2>/dev/null || true
  exit 1
fi

# shellcheck disable=SC2329
cleanup() {
  fusermount -u "$MOUNT" 2>/dev/null || fusermount -uz "$MOUNT" 2>/dev/null || true
  kill "$GC_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP QUIT

element-desktop
EXIT_CODE=$?

exit "$EXIT_CODE"
