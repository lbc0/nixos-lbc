#!/usr/bin/env bash
# Runs as root via a systemd service (hosts/common/room-lock-guard.nix), so
# `kill <pid>` from the lbc session fails with EPERM — only root/sudo can
# stop it. Session details (Wayland socket, niri socket) are discovered
# once at startup, since they don't change while the session is alive.
set -euo pipefail
shopt -s nullglob

USER_NAME="lbc"
USER_UID="$(id -u "$USER_NAME")"
export XDG_RUNTIME_DIR="/run/user/$USER_UID"

WAYLAND_DISPLAY=""
for f in "$XDG_RUNTIME_DIR"/wayland-*; do
  b="$(basename "$f")"
  [[ "$b" == *.lock ]] && continue
  WAYLAND_DISPLAY="$b"
  break
done

NIRI_SOCKET=""
for f in "$XDG_RUNTIME_DIR"/niri.*.sock; do
  [ -S "$f" ] && NIRI_SOCKET="$f" && break
done

if [ -z "$WAYLAND_DISPLAY" ] || [ -z "$NIRI_SOCKET" ]; then
  echo "room-lock-guard: could not find wayland/niri socket for $USER_NAME, retrying in 5s" >&2
  sleep 5
  exit 1
fi

as_user() {
  runuser -u "$USER_NAME" -- env \
    XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
    NIRI_SOCKET="$NIRI_SOCKET" \
    PATH="/etc/profiles/per-user/$USER_NAME/bin:/run/current-system/sw/bin:${PATH:-}" \
    "$@"
}

# Returns "yes" if the sensitive room is currently focused (either the
# Element desktop app itself, or the Brave web-app window for Element),
# otherwise "no".
is_focused_state() {
  as_user niri msg --json windows | python3 -c "
import json, sys
ROOM_KEYWORD='General'
keyword = ROOM_KEYWORD.lower()
wins = json.load(sys.stdin)
result = 'no'
for w in wins:
    if not w.get('is_focused'):
        continue
    app_id = w.get('app_id','')
    title = w.get('title','')
    if 'element' in app_id.lower() and keyword in title.lower():
        result = 'yes'
    elif app_id == 'brave-browser' and ( title == 'Element - Brave' or title == 'Continue to your account - Brave' ) :
        result = 'yes'
    break
print(result)
"
}

LAST_UNLOCK_TS=0
UNLOCK_COOLDOWN_SECS=3

libinput debug-events 2>/dev/null | while IFS= read -r line; do
  TRIGGER=0
  if echo "$line" | grep -q "KEYBOARD_KEY.*pressed"; then TRIGGER=1; fi
  if echo "$line" | grep -q "POINTER_BUTTON.*pressed"; then TRIGGER=1; fi

  if [ "$TRIGGER" = "1" ]; then
    NOW=$(date +%s)
    # Grace period after a real unlock: swaylock-png only returns once the
    # correct password has been entered, so reaching this state requires
    # actually unlocking — unlike the old pre-check cooldown that was
    # removed for being gameable, this one can't be triggered for free.
    # It exists purely so you can move off the room / switch focus after
    # unlocking, without getting caught in an immediate re-lock loop.
    if [ $(( NOW - LAST_UNLOCK_TS )) -lt "$UNLOCK_COOLDOWN_SECS" ]; then
      continue
    fi

    # Single check, no BEFORE/AFTER re-check (that was gameable — see
    # history).
    if [ "$(is_focused_state)" = "yes" ]; then
      as_user swaylock-png
      LAST_UNLOCK_TS=$(date +%s)
    fi
  fi
done
