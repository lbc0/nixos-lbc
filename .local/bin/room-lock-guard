#!/usr/bin/env bash
set -euo pipefail

is_focused_state() {
  niri msg --json windows 2>/dev/null | python3 -c "
import json, sys
ROOM_KEYWORD='General'
keyword = ROOM_KEYWORD.lower()
wins = json.load(sys.stdin)
result = 'no'
for w in wins:
    if not w.get('is_focused'):
        continue
    app_id = w.get('app_id','')
    title = w.get('title','')
    if 'element' in app_id.lower() and keyword in title.lower():
        result = 'kill'
    elif app_id == 'brave-browser' and title == 'Element - Brave':
        result = 'nokill'
    break
print(result)
"
}

libinput debug-events 2>/dev/null | while IFS= read -r line; do
  TRIGGER=0
  if echo "$line" | grep -q "KEYBOARD_KEY.*pressed"; then
    TRIGGER=1
  fi
  if echo "$line" | grep -q "POINTER_BUTTON.*pressed"; then
    TRIGGER=1
  fi
  if [ "$TRIGGER" = "1" ]; then
    BEFORE=$(is_focused_state)
    sleep 0.3
    AFTER=$(is_focused_state)
    if [ "$BEFORE" = "$AFTER" ] && [ "$BEFORE" != "no" ]; then
      if [ "$BEFORE" = "kill" ]; then
        pkill -f element-desktop
      fi
      swaylock-png
    fi
  fi
done
